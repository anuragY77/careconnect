# CareConnect environment configuration
# Copy to .env and fill in local values. Never commit the real .env file.

# --- General ---
SPRING_PROFILES_ACTIVE=local
APP_TIMEZONE=Asia/Kolkata
FRONTEND_ORIGIN=http://localhost:4200

# --- PostgreSQL (clinical data) ---
POSTGRES_DB=careconnect
POSTGRES_USER=
POSTGRES_PASSWORD=
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/careconnect
SPRING_DATASOURCE_USERNAME=
SPRING_DATASOURCE_PASSWORD=

# --- Security ---
JWT_SECRET=
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=7
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

# --- Email (Mailpit in development) ---
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_FROM=no-reply@careconnect.local

# --- Business settings (configurable, reviewed by project owner) ---
APPOINTMENT_SLOT_MINUTES=15
LATE_CANCEL_HOURS=24
OVERRIDE_REASON_MIN_LENGTH=10
