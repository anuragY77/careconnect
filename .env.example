# CareConnect environment configuration
# Copy to .env and adjust. Never commit the real .env file.
# The values below are for LOCAL DEVELOPMENT ONLY. Use strong, unique values anywhere else.

# --- General ---
SPRING_PROFILES_ACTIVE=local
APP_TIMEZONE=Asia/Kolkata
FRONTEND_PORT=8080
FRONTEND_ORIGIN=http://localhost:8080

# --- PostgreSQL (clinical data and audit trail) ---
# The backend connection is built from these three values by docker-compose.yml.
POSTGRES_DB=careconnect
POSTGRES_USER=careconnect
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_PORT=5432

# --- Security ---
# Local development placeholder; the application will refuse to use it outside the local profile.
# Generate a real one with: openssl rand -base64 48
JWT_SECRET=dev-only-secret-change-me-dev-only-secret-change-me-0123456789
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=7
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

# --- Email (Mailpit in development; inbox at http://localhost:8025) ---
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_FROM=no-reply@careconnect.local
MAILPIT_UI_PORT=8025

# --- Business settings (configurable, reviewed by project owner) ---
APPOINTMENT_SLOT_MINUTES=15
LATE_CANCEL_HOURS=24
OVERRIDE_REASON_MIN_LENGTH=10
